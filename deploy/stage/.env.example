# External PostgreSQL connection used by the backend container.
DATABASE_URL=postgresql+psycopg://socrates:CHANGE_ME@postgres-host:5432/socrates

SOCRATES_HTTP_PORT=8080
SOCRATES_SOURCE_SHA=stage
SOCRATES_RELEASE_ID=socrates-stage
SOCRATES_ALEMBIC_REVISION=head

BACKEND_IMAGE=ghcr.io/socratic-classroom-ntnu/socrates-backend:stage
FRONTEND_IMAGE=ghcr.io/socratic-classroom-ntnu/socrates-frontend:stage
