  "view": {
    "dimensions": [
      {
        "index": 0,
        "name": "判斷依據",
        "low_pole": "主要看行為本身是否違反不可侵犯的原則，例如不主動傷害無辜者。",
        "high_pole": "主要看結果的總體影響，例如傷亡人數多寡與整體福祉。",
        "source": "llm"
      },
      {
        "index": 1,
        "name": "行動與不作為",
        "low_pole": "認為主動造成傷害比袖手旁觀更需要道德辯護。",
        "high_pole": "認為不作為同樣要負責，救人機會出現時就應該介入。",
        "source": "llm"
      },
      {
        "index": 2,
        "name": "個人與群體",
        "low_pole": "重視每個人的獨特價值，不應把個人當作達成整體目標的工具。",
        "high_pole": "重視群體的共同利益，認為在困難時刻個人需要為整體做出讓步。",
        "source": "llm"
      },
      {
        "index": 3,
        "name": "情境與普遍規則",
        "low_pole": "認為道德判斷應依具體情境的細節而定，不同情況需要不同回應。",
        "high_pole": "偏好統一可適用的規則，認為一致性能避免主觀判斷造成的不公。",
        "source": "llm"
      },
      {
        "index": 4,
        "name": "直覺與推理",
        "low_pole": "較信任直覺的道德反應，認為情感上的不安本身提供重要線索。",
        "high_pole": "較信任經過推演的論證，認為應該檢驗並修正第一時間的感覺。",
        "source": "llm"
      }
    ],
    "students": [
      {
