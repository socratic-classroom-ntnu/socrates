          {
            "dimension_index": 2,
            "score": 3.0,
            "sources": [
              {
                "message_id": "26dfde17-77ec-477c-a90f-328c505a4c60",
                "quote": "因為五大於一",
                "start": 0,
                "end": 6
              },
              {
                "message_id": "017e2875-fc99-4247-a216-6e4b7b3cce77",
                "quote": "那我前面說的五大於一就不成立了",
                "start": 9,
                "end": 24
