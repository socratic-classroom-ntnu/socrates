  "view": {
    "dimensions": [
      {
        "index": 0,
        "name": "判斷依據",
        "low_pole": "著重行為的結果，認為能讓最多人受益的選擇較值得採取。",
        "high_pole": "著重行為本身的性質，認為某些行為即使結果較好仍不應被做出。",
        "source": "llm"
      },
      {
        "index": 1,
        "name": "行動與不作為",
        "low_pole": "認為主動造成傷害與袖手旁觀導致傷害在道德上責任相近。",
        "high_pole": "認為主動介入造成的傷害責任較重，即使結果相同也應有所區別。",
        "source": "llm"
      },
      {
        "index": 2,
        "name": "個人與群體",
        "low_pole": "認為每個人的生命價值相同，應以數字多寡作為主要考量。",
        "high_pole": "認為個人有不可被他人取代的權利，不宜為了群體利益被犧牲。",
        "source": "llm"
      },
      {
        "index": 3,
        "name": "情境敏感度",
        "low_pole": "認為原則應一致適用，不因人物關係或細節不同而改變判斷。",
        "high_pole": "認為具體情境、人物關係與不確定性會實質影響應採取的選擇。",
        "source": "llm"
      },
      {
        "index": 4,
        "name": "情感與理性",
        "low_pole": "認為道德判斷應依循清楚的推理，直覺感受只能作為參考。",
        "high_pole": "認為直覺與情感反應是道德判斷的重要依據，不應完全被推理取代。",
        "source": "llm"
      }
    ],
