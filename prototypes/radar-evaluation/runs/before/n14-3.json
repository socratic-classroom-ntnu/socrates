      },
      {
        "student_id": "adc20cfc-054b-45c5-8ab6-158eeb7f04bb",
        "display_name": "張家豪",
        "scores": [
          {
            "dimension_index": 0,
            "score": 3.0,
            "sources": [
              {
                "message_id": "9d664098-410f-45ca-8acc-7832c5e15bad",
                "quote": "那個人死是副作用，不是我想要他死",
                "start": 9,
                "end": 25
              },
              {
                "message_id": "203aeec9-eb64-4c92-95a9-0d584fc44ab1",
                "quote": "他的死就是手段",
                "start": 18,
                "end": 25
              }
            ]
          },
          {
            "dimension_index": 1,
            "score": 2.0,
            "sources": [
              {
                "message_id": "9d664098-410f-45ca-8acc-7832c5e15bad",
                "quote": "會拉。電車轉過去，那個人死是副作用",
                "start": 0,
                "end": 17
              }
            ]
          },
          {
            "dimension_index": 2,
            "score": 2.0,
            "sources": [
              {
                "message_id": "07b1b8c0-c37e-427e-962c-86faea508fa4",
                "quote": "我的目的是救五個人，不是殺那一個。",
                "start": 0,
                "end": 17
              },
              {
                "message_id": "203aeec9-eb64-4c92-95a9-0d584fc44ab1",
                "quote": "他的死就是手段",
                "start": 18,
                "end": 25
              }
            ]
          },
          {
            "dimension_index": 3,
            "score": 3.0,
            "sources": [
