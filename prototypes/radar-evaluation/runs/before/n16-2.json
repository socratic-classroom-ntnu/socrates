  "view": {
    "dimensions": [
      {
        "index": 0,
        "name": "判斷依據",
        "low_pole": "主要看行為本身是否合乎原則，例如不主動傷害無辜者，即使結果較差也如此堅持。",
        "high_pole": "主要看結果的總體影響，例如救更多人的結果較好，因此值得做出艱難的選擇。",
        "source": "llm"
      },
      {
        "index": 1,
        "name": "行動與不作為",
        "low_pole": "主動造成傷害與坐視不救在道德上有本質差別，介入本身需要更強的理由。",
        "high_pole": "不作為同樣要負責，若能避免傷亡卻不行動，與主動造成結果的責任程度相近。",
        "source": "llm"
      },
      {
        "index": 2,
        "name": "個人與多數",
        "low_pole": "每個人的生命都有不可被交換的價值，不應為了多數而把某人當作工具。",
        "high_pole": "面對大規模傷亡時，應以減少總體傷亡為優先，個人權益需在整體利益下做出調整。",
        "source": "llm"
      },
      {
        "index": 3,
        "name": "情感與理性",
        "low_pole": "直覺上的不忍與厭惡是重要的道德線索，即使難以用公式說明，也值得信任。",
        "high_pole": "道德判斷應盡量經由清楚的推理得出，情感反應可能受情境干擾，需要經過檢驗。",
        "source": "llm"
      },
      {
        "index": 4,
        "name": "情境敏感度",
        "low_pole": "道德原則應該普遍適用，不因具體細節如何安排而改變答案。",
        "high_pole": "具體條件，例如被犧牲者是誰、是否已知情、有無其他選項，會實質影響判斷。",
        "source": "llm"
      }
    ],
