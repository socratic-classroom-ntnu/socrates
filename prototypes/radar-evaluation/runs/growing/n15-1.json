          },
          {
            "dimension_index": 1,
            "score": 2.0,
            "sources": [
              {
                "message_id": "e4e8c5b0-9246-4cfd-b50b-06a778ab3147",
                "quote": "犧牲自己是我自己的選擇",
                "start": 7,
                "end": 18
              }
            ]
          },
          {
            "dimension_index": 2,
            "score": 2.0,
            "sources": []
          },
          {
            "dimension_index": 3,
            "score": 2.0,
            "sources": []
          },
          {
            "dimension_index": 4,
            "score": 3.0,
            "sources": [
              {
                "message_id": "9cf2e80a-aac6-4ee1-9885-585e1e87715c",
                "quote": "我會自己跳下去，不推他。",
                "start": 0,
                "end": 12
              },
              {
                "message_id": "27630158-b982-426f-91bc-1e0488325336",
                "quote": "但至少我不用決定別人的命",
                "start": 10,
                "end": 22
              }
            ]
          }
        ]
      },
      {
        "student_id": "36533e02-2f67-44ed-8596-019b2cb30279",
        "display_name": "羅冠廷",
        "scores": [
          {
            "dimension_index": 0,
            "score": 3.0,
            "sources": [
              {
