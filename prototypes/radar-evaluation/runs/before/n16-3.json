  "view": {
    "dimensions": [
      {
        "index": 0,
        "name": "判斷依據",
        "low_pole": "主要看行動的結果，認為能減少最多傷亡的選擇就是較好的選擇。",
        "high_pole": "主要看行動本身是否合乎道德原則，認為不應主動傷害無辜者，即使結果較差。",
        "source": "llm"
      },
      {
        "index": 1,
        "name": "責任歸屬",
        "low_pole": "認為拉動拉桿的人要為結果負責，因為是他主動改變了事情的走向。",
        "high_pole": "認為責任應看事件原本的發展，主動介入與袖手旁觀在責任上有明顯差異。",
        "source": "llm"
      },
      {
        "index": 2,
        "name": "個人與群體",
        "low_pole": "重視每個人的價值相同，數字多寡本身就是重要的道德理由。",
        "high_pole": "重視個體的權利與不可侵犯性，認為不能為了群體利益把個人當成工具。",
        "source": "llm"
      },
      {
        "index": 3,
        "name": "情境敏感度",
        "low_pole": "認為這類困境應有統一的原則，不同情境下應得出一致的答案。",
        "high_pole": "認為細節很重要，例如誰站在哪裡、有無其他選項，都可能改變正確的判斷。",
        "source": "llm"
      },
      {
        "index": 4,
        "name": "情感與理性",
        "low_pole": "傾向以冷靜的推理計算得失，認為情緒反應不應主導道德判斷。",
        "high_pole": "認為直覺與情感反應也是道德判斷的重要依據，不應完全排除。",
        "source": "llm"
      }
    ],
