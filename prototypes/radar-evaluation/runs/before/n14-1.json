      },
      {
        "student_id": "f399de5c-ee78-47df-a3c2-aef7fc2cb491",
        "display_name": "林雨潔",
        "scores": [
          {
            "dimension_index": 0,
            "score": 4.0,
            "sources": [
              {
                "message_id": "83f5e286-43fe-4b10-8f86-3ad7766979f4",
                "quote": "殺一個無辜的人就是錯的，這條線不能跨。",
                "start": 7,
                "end": 26
              }
            ]
          },
          {
            "dimension_index": 1,
            "score": 4.0,
            "sources": [
              {
                "message_id": "31f4f01f-c8a8-4548-8071-f8da5df72c0d",
                "quote": "可是拉了以後那個人是因為我才死的。",
                "start": 16,
                "end": 33
              }
            ]
          },
          {
            "dimension_index": 2,
            "score": 4.0,
            "sources": [
              {
                "message_id": "9f0e69a4-2003-4670-8bda-dc8314369844",
                "quote": "人不能被拿來當成救別人的工具。",
                "start": 0,
                "end": 15
              }
            ]
          },
          {
            "dimension_index": 3,
            "score": 1.0,
            "sources": [
              {
                "message_id": "83f5e286-43fe-4b10-8f86-3ad7766979f4",
                "quote": "不管救幾個人，殺一個無辜的人就是錯的",
                "start": 0,
                "end": 18
              }
            ]
          },
          {
            "dimension_index": 4,
            "score": 2.0,
            "sources": []
          }
        ]
      },
      {
        "student_id": "adc20cfc-054b-45c5-8ab6-158eeb7f04bb",
