  "view": {
    "dimensions": [
      {
        "index": 0,
        "name": "判斷依據",
        "low_pole": "著重行為的結果，認為能減少最多傷亡的選擇才算合理。",
        "high_pole": "著重行為本身的性質，認為主動傷害無辜者本身就有其道德界線。",
        "source": "llm"
      },
      {
        "index": 1,
        "name": "行動與不作為",
        "low_pole": "認為扳動開關與袖手旁觀在道德責任上差異不大，重點在於最終結果。",
        "high_pole": "認為主動介入造成的傷害比原本就存在的危險承擔更多責任。",
        "source": "llm"
      },
      {
        "index": 2,
        "name": "個人與群體",
        "low_pole": "認為每個人的生命價值相同，數字多寡應成為決定的主要依據。",
        "high_pole": "認為個人的權利與尊嚴不能因為他人人數較多而被犧牲。",
        "source": "llm"
      },
      {
        "index": 3,
        "name": "情境彈性",
        "low_pole": "認為原則應該一致適用，不因情境的細節而改變判斷。",
        "high_pole": "認為具體條件（如當事人身份、風險程度）會實質改變應有的判斷。",
        "source": "llm"
      },
      {
        "index": 4,
        "name": "直覺與推理",
        "low_pole": "傾向依循清楚的推論步驟，即使結論令人不安也願意接受。",
        "high_pole": "傾向相信直覺的道德反應，認為直覺可以作為推理的重要依據。",
        "source": "llm"
      }
    ],
