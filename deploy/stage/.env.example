DATABASE_URL=postgresql+psycopg://socrates:REPLACE_ME@REPLACE_ME/socrates
SOCRATES_SOURCE_SHA=replace-with-stage-sha
SOCRATES_PUBLIC_ORIGIN=https://socrates.driseam.com
SOCRATES_ALLOWED_ORIGINS=https://socrates.driseam.com
# 舊的 RUN2_* 名稱仍可用（程式與 compose 都會 fallback），下一版移除。
CLASSROOM_COOKIE_SECURE=true
CLASSROOM_LLM_DAILY_BUDGET=1000000

SOCRATES_MAIL_TRANSPORT=resend
RESEND_API_KEY=
RESEND_FROM=Socratic Classroom <verify@mail.socrates.driseam.com>
RESEND_WEBHOOK_SECRET=

# Research sidebar (Google Programmable Search). The cx id is public; leave empty to keep search off.
SOCRATES_GOOGLE_CSE_ID=
SOCRATES_GOOGLE_CSE_SCOPE=sites
