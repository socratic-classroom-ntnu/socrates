      {
        "student_id": "78b74549-0520-4328-b53f-4b4baad96eed",
        "display_name": "楊佳穎",
        "scores": [
          {
            "dimension_index": 0,
            "score": 3.0,
            "sources": [
              {
                "message_id": "3640ac18-83e2-4756-bcd3-39817655d034",
                "quote": "這會開很壞的先例",
                "start": 8,
                "end": 16
              }
            ]
          },
          {
            "dimension_index": 1,
            "score": 2.0,
            "sources": []
          },
          {
            "dimension_index": 2,
            "score": 3.0,
            "sources": [
              {
                "message_id": "48233a9d-a7a2-4151-926f-185b17627424",
                "quote": "今天是電車，明天醫院就可以拿一個健康的人的器官救五個病人。",
                "start": 0,
                "end": 29
              }
            ]
          },
          {
            "dimension_index": 3,
            "score": 2.0,
            "sources": [
              {
                "message_id": "35893c6b-bd74-4c6b-8135-550a2625ac3d",
                "quote": "如果大家都接受可以為了多數犧牲一個人，那社會會很可怕。",
                "start": 0,
                "end": 27
              }
            ]
          },
          {
            "dimension_index": 4,
            "score": 4.0,
            "sources": [
              {
                "message_id": "3495bac1-3c3e-4e8f-99dd-d4ee8295986c",
                "quote": "所以我不拉，要守住不能犧牲人的規則。",
                "start": 0,
                "end": 18
              }
            ]
          }
        ]
      },
      {
        "student_id": "8b24fdd5-f6a7-44e0-80f6-188ea16a6926",
        "display_name": "謝承恩",
        "scores": [
          {
            "dimension_index": 0,
            "score": 3.0,
            "sources": [
              {
                "message_id": "e4e8c5b0-9246-4cfd-b50b-06a778ab3147",
                "quote": "犧牲別人不對",
                "start": 0,
                "end": 6
              },
              {
                "message_id": "f2d5fb89-c95f-40c9-bfee-75f0169781de",
                "quote": "不要拉也不要害別人",
                "start": 15,
                "end": 24
