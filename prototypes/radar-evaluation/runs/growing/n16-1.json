  "view": {
    "dimensions": [
      {
        "index": 0,
        "name": "判斷依據",
        "low_pole": "主要看行動的結果，哪種做法讓整體傷亡最少就應該選它。",
        "high_pole": "主要看行動本身是否侵犯個人權利或違反原則，即使結果較差也不應主動傷害他人。",
        "source": "llm"
      },
      {
        "index": 1,
        "name": "行動責任",
        "low_pole": "區分主動造成傷害與袖手旁觀，認為主動介入的人責任較重。",
        "high_pole": "認為見死不救同樣有責任，造成的傷亡結果才是判斷重點，不需區分是否主動。",
        "source": "llm"
      },
      {
        "index": 2,
        "name": "人際關係",
        "low_pole": "認為每個人的生命價值相同，不因身分、數量以外的條件而有差別。",
        "high_pole": "認為情境脈絡與人與人之間的連結會影響抉擇，不能只用數字比較。",
        "source": "llm"
      },
      {
        "index": 3,
        "name": "不確定性",
        "low_pole": "在資訊有限時仍願意根據現有數據做出最合理的估算並承擔後果。",
        "high_pole": "認為在資訊不足、無法確定結果時，應保守行事，避免做出難以回頭的決定。",
        "source": "llm"
      },
      {
        "index": 4,
        "name": "道德直覺",
        "low_pole": "相信可以用理性推論與計算來檢驗道德選擇，直覺只能作參考。",
        "high_pole": "相信直覺與情感反應是可靠的道德指引，不應完全被理性計算取代。",
        "source": "llm"
      }
    ],
