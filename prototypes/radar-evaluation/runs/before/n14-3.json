          },
          {
            "dimension_index": 2,
            "score": 3.0,
            "sources": [
              {
                "message_id": "e17f7ece-5e7b-4b3e-85b0-acdc9fe9fee2",
                "quote": "每個人有自己的命，不該由我去改變。",
                "start": 3,
                "end": 20
              }
