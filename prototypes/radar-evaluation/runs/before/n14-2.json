  "view": {
    "dimensions": [
      {
        "index": 0,
        "name": "判斷依據",
        "low_pole": "著重行為的結果，認為能減少傷亡總量的選擇就是較好的選擇。",
        "high_pole": "著重行為本身的性質，認為主動傷害無辜者有其道德界線，即使結果較好也不應跨越。",
        "source": "llm"
      },
      {
        "index": 1,
        "name": "主動與被動",
        "low_pole": "認為讓事情發生與主動造成傷害在道德上差異不大，責任主要看結果。",
        "high_pole": "認為主動介入造成的傷害責任較重，即使總數較少，也不宜由自己直接選擇犧牲。",
        "source": "llm"
      },
      {
        "index": 2,
        "name": "個人與群體",
        "low_pole": "認為保護最多人的群體利益應優先於個人權利。",
        "high_pole": "認為每個人的生命與權利具有不可被群體計算取代的獨立價值。",
        "source": "llm"
      },
      {
        "index": 3,
        "name": "情境彈性",
        "low_pole": "認為道德原則應依情境調整，具體條件（如誰、為何、有無其他選項）會改變判斷。",
        "high_pole": "認為應堅持一致的普遍原則，避免因情境不同而讓判斷變得任意。",
        "source": "llm"
      },
      {
        "index": 4,
        "name": "直覺與推理",
        "low_pole": "傾向相信直覺的道德反應，認為難以計算的情感判斷同樣有其價值。",
        "high_pole": "傾向透過明確的推理與權衡來做決定，認為應能說明每一步的理由。",
        "source": "llm"
      }
    ],
