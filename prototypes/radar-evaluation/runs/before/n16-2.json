            "dimension_index": 4,
            "score": 2.0,
            "sources": [
              {
                "message_id": "2675ed7b-d135-405f-b182-292d2627ea0e",
                "quote": "不推，理由一樣",
                "start": 0,
                "end": 7
              }
            ]
          }
        ]
      },
      {
