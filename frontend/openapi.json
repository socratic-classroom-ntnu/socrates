  "components": {
    "schemas": {
      "ConversationRoomView": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/SessionDetail"
          },
          "room": {
            "$ref": "#/components/schemas/RoomProjection"
          }
        },
        "type": "object",
        "required": [
          "detail",
          "room"
        ],
        "title": "ConversationRoomView"
      },
      "CreateSessionRequest": {
        "properties": {
          "ladder_id": {
            "type": "string",
            "title": "Ladder Id"
          },
          "restart_existing": {
            "type": "boolean",
            "title": "Restart Existing"
          }
        },
        "type": "object",
        "required": [
          "ladder_id"
        ],
        "title": "CreateSessionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MessageView": {
        "properties": {
          "seq": {
            "type": "integer",
            "title": "Seq"
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "tutor",
              "system"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "seq",
          "role",
          "content"
        ],
        "title": "MessageView"
      },
      "ReleaseView": {
        "properties": {
          "release_id": {
            "type": "string",
            "title": "Release Id"
          },
          "source_sha": {
            "type": "string",
            "title": "Source Sha"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "alembic_revision": {
            "type": "string",
            "title": "Alembic Revision"
          },
          "built_at": {
            "type": "string",
            "title": "Built At"
          }
        },
        "type": "object",
        "required": [
          "release_id",
          "source_sha",
          "environment",
          "alembic_revision",
          "built_at"
        ],
        "title": "ReleaseView"
      },
      "RoomCapabilities": {
        "properties": {
          "history": {
            "type": "boolean",
            "title": "History",
            "default": true
          },
          "text_input": {
            "type": "boolean",
            "title": "Text Input",
            "default": true
          },
          "voice_input": {
            "type": "boolean",
            "title": "Voice Input",
            "default": true
          },
          "transcript_draft": {
            "type": "boolean",
            "title": "Transcript Draft",
            "default": true
          }
        },
        "type": "object",
        "title": "RoomCapabilities"
      },
      "RoomProjection": {
        "properties": {
          "room_revision": {
            "type": "string",
            "title": "Room Revision",
            "default": "ce-room-v1"
          },
          "tutor_state": {
            "type": "string",
            "enum": [
              "idle",
              "listening",
              "thinking",
              "speaking"
            ],
            "title": "Tutor State",
            "default": "idle"
          },
          "avatar_id": {
            "type": "string",
            "const": "brunette",
            "title": "Avatar Id",
            "default": "brunette"
          },
          "capabilities": {
            "$ref": "#/components/schemas/RoomCapabilities"
          }
        },
        "type": "object",
        "title": "RoomProjection"
      },
      "SendMessageRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "SendMessageRequest"
      },
      "SessionDetail": {
        "properties": {
          "session": {
            "$ref": "#/components/schemas/SessionInfo"
          },
          "stage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StageView"
              },
              {
                "type": "null"
              }
            ]
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageView"
            },
            "type": "array",
            "title": "Messages"
          },
          "available_actions": {
            "items": {
              "type": "string",
              "enum": [
                "send_message",
                "advance",
                "end",
                "retry"
              ]
            },
            "type": "array",
            "title": "Available Actions"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SummaryView"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "session",
          "stage",
          "messages",
          "available_actions",
          "summary"
        ],
        "title": "SessionDetail"
      },
      "SessionHistoryItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "ended"
            ],
            "title": "Status"
          },
          "flow_state": {
            "type": "string",
            "enum": [
              "active_in_stage",
              "at_crossroad",
              "awaiting_wrap_up",
              "ended"
            ],
            "title": "Flow State"
          },
          "current_stage_index": {
            "type": "integer",
            "title": "Current Stage Index"
          },
          "total_stages": {
            "type": "integer",
            "title": "Total Stages"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "updated_at": {
            "type": "string",
