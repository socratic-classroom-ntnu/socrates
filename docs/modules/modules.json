  "contracts": [
    {
      "name": "帳號（/auth/*）",
      "backend": "identity-access",
      "source": "classroom_schemas.py（Register、Login、ResetRequest…）→ api/types.ts",
      "state": "產生型別 ✅；端點在 routes/classroom.py",
      "consumer": "登入、註冊、驗證畫面"
    },
    {
      "name": "教室房間（/classrooms/*）",
      "backend": "classroom-core",
      "source": "classroom_schemas.py、room_schemas.py → api/types.ts",
      "state": "產生型別 ✅",
      "consumer": "學生端課堂畫面"
    },
    {
      "name": "分組課（/groups/*）",
      "backend": "group-dialogue",
      "source": "routes/groups.py",
      "state": "缺 response_model，前端型別手寫（已寄契約請求）",
      "consumer": "分組課、教師分析畫面"
    },
    {
      "name": "AI 學生（/ai-students/*）",
      "backend": "group-dialogue",
      "source": "routes/ai_students.py",
      "state": "部分手寫",
      "consumer": "分組課畫面"
    },
    {
      "name": "雷達圖",
      "backend": "analytics",
      "source": "待定",
      "state": "等契約（設計稿）",
      "consumer": "教師分析畫面"
    },
    {
      "name": "AI 供應商（/provider-profiles/*、/ai-settings/*）",
      "backend": "ai-providers",
      "source": "routes/provider_profiles.py → api/types.ts",
      "state": "產生型別 ✅",
      "consumer": "AI 設定、出題畫面"
    },
    {
      "name": "出題與題庫（/library/*、/question-bank/*、/script-assist/*）",
      "backend": "content-authoring",
      "source": "各 route 的 schema → api/types.ts",
      "state": "產生型別 ✅",
      "consumer": "教師端出題畫面"
    },
    {
      "name": "單人對話（/api/sessions/*）",
      "backend": "solo-dialogue",
      "source": "api/schemas.py、transcript_schemas.py → api/types.ts",
      "state": "產生型別 ✅",
      "consumer": "單人對話畫面"
    },
    {
      "name": "公開設定（/public-config）",
      "backend": "platform",
      "source": "routes/public_config.py",
      "state": "✅",
      "consumer": "全站"
    },
    {
      "name": "TTS（文字→音訊＋字時間點）",
      "backend": "llm-runtime",
      "source": "待定",
      "state": "等契約",
      "consumer": "導師人像"
    },
    {
      "name": "人像模型清單（/avatar-packs/catalog.json）",
      "backend": "platform",
      "source": "Portal avatar-serve 產生的靜態檔 → api/avatarCatalog.ts",
      "state": "✅",
      "consumer": "導師人像"
    }
  ]
}
