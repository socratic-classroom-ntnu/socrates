  "view": {
    "dimensions": [
      {
        "index": 0,
        "name": "判斷依據",
        "low_pole": "主要看行為本身是否違反不可侵犯的原則，即使結果較差也不應主動傷害他人。",
        "high_pole": "主要看結果的總體影響，認為減少整體傷亡有其道德重量，應以結果來權衡。",
        "source": "llm"
      },
      {
        "index": 1,
        "name": "行動責任",
        "low_pole": "區分主動造成傷害與被動放任發生，認為主動介入者承擔的責任更重。",
        "high_pole": "不區分作為與不作為，認為見死不救與親手造成結果在道德上的差別有限。",
        "source": "llm"
      },
      {
        "index": 2,
        "name": "個人與群體",
        "low_pole": "重視每個個體的獨特性與不可替代性，認為不應把個人當成計算的單位。",
        "high_pole": "重視群體福祉的總量，認為在必要時個人利益應讓位於多數人的生存。",
        "source": "llm"
      },
      {
        "index": 3,
        "name": "情境彈性",
        "low_pole": "傾向訂立明確的通則，認為穩定的規則比逐案判斷更能保護每個人。",
        "high_pole": "傾向依具體情境調整判斷，認為同樣的行動在不同條件下可能有不同的對錯。",
        "source": "llm"
      },
      {
        "index": 4,
        "name": "直覺與推理",
        "low_pole": "相信道德直覺有其可靠性，當推論結論違背直覺時，會懷疑推論本身。",
        "high_pole": "相信應以嚴謹推理為準，即使結論令人不安，也願意順著論證接受結果。",
        "source": "llm"
      }
    ],
