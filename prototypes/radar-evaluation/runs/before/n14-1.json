              }
            ]
          },
          {
            "dimension_index": 3,
            "score": 3.0,
            "sources": [
              {
                "message_id": "203aeec9-eb64-4c92-95a9-0d584fc44ab1",
                "quote": "這次那個人是被我拿來擋車的",
                "start": 4,
                "end": 17
              }
            ]
