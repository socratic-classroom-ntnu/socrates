{
  "openapi": "3.1.0",
  "info": {
    "title": "Socrates API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/sessions": {
      "post": {
        "tags": [
          "sessions"
        ],
        "summary": "Create Session",
        "operationId": "create_session_api_sessions_post",
        "parameters": [
          {
            "name": "x-learner-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "X-Learner-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}": {
      "get": {
        "tags": [
          "sessions"
        ],
        "summary": "Get Session",
        "operationId": "get_session_api_sessions__session_id__get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          },
          {
            "name": "x-learner-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "X-Learner-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/messages": {
      "post": {
        "tags": [
          "messages"
        ],
        "summary": "Send Message",
        "operationId": "send_message_api_sessions__session_id__messages_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          },
          {
            "name": "x-learner-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "X-Learner-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/retry": {
      "post": {
        "tags": [
          "messages"
        ],
        "summary": "Retry",
        "operationId": "retry_api_sessions__session_id__retry_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          },
          {
            "name": "x-learner-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "X-Learner-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/end": {
      "post": {
        "tags": [
          "summaries"
        ],
        "summary": "End Session",
        "operationId": "end_session_api_sessions__session_id__end_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          },
          {
            "name": "x-learner-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "X-Learner-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/summary": {
      "post": {
        "tags": [
          "summaries"
        ],
        "summary": "Create Summary",
        "operationId": "create_summary_api_sessions__session_id__summary_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          },
          {
            "name": "x-learner-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "X-Learner-Id"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "summaries"
        ],
        "summary": "Read Summary",
        "operationId": "read_summary_api_sessions__session_id__summary_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          },
          {
            "name": "x-learner-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "X-Learner-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSessionRequest": {
        "properties": {
          "ladder_id": {
            "type": "string",
            "title": "Ladder Id"
          }
        },
        "type": "object",
        "required": [
          "ladder_id"
        ],
        "title": "CreateSessionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MessageView": {
        "properties": {
          "seq": {
            "type": "integer",
            "title": "Seq"
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "tutor",
              "system"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "seq",
          "role",
          "content"
        ],
        "title": "MessageView"
      },
      "SendMessageRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "SendMessageRequest"
      },
      "SessionDetail": {
        "properties": {
          "session": {
            "$ref": "#/components/schemas/SessionInfo"
          },
          "stage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StageView"
              },
              {
                "type": "null"
              }
            ]
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageView"
            },
            "type": "array",
            "title": "Messages"
          },
          "available_actions": {
            "items": {
              "type": "string",
              "enum": [
                "send_message",
                "advance",
                "end",
                "retry"
              ]
            },
            "type": "array",
            "title": "Available Actions"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SummaryView"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "session",
          "stage",
          "messages",
          "available_actions",
          "summary"
        ],
        "title": "SessionDetail",
        "description": "GET 專用：回傳完整訊息而非增量。"
      },
      "SessionInfo": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "ended"
            ],
            "title": "Status"
          },
          "flow_state": {
            "type": "string",
            "enum": [
              "active_in_stage",
              "at_crossroad",
              "awaiting_wrap_up",
              "ended"
            ],
            "title": "Flow State"
          },
          "current_stage_index": {
            "type": "integer",
            "title": "Current Stage Index"
          },
          "total_stages": {
            "type": "integer",
            "title": "Total Stages"
          },
          "end_reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "student_ended",
                  "completed",
                  "restarted"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "End Reason"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "flow_state",
          "current_stage_index",
          "total_stages"
        ],
        "title": "SessionInfo"
      },
      "SessionView": {
        "properties": {
          "session": {
            "$ref": "#/components/schemas/SessionInfo"
          },
          "stage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StageView"
              },
              {
                "type": "null"
              }
            ]
          },
          "appended_messages": {
            "items": {
              "$ref": "#/components/schemas/MessageView"
            },
            "type": "array",
            "title": "Appended Messages"
          },
          "available_actions": {
            "items": {
              "type": "string",
              "enum": [
                "send_message",
                "advance",
                "end",
                "retry"
              ]
            },
            "type": "array",
            "title": "Available Actions"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SummaryView"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "session",
          "stage",
          "appended_messages",
          "available_actions",
          "summary"
        ],
        "title": "SessionView",
        "description": "所有會改變狀態的端點共用的回應形狀（設計規格 §9.1）。"
      },
      "StageOutcomeView": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "in_progress",
              "goal_met",
              "capped",
              "stopped_early",
              "skipped"
            ],
            "title": "Status"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "index",
          "status",
          "title"
        ],
        "title": "StageOutcomeView"
      },
      "StageView": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "opening_statement": {
            "type": "string",
            "title": "Opening Statement"
          }
        },
        "type": "object",
        "required": [
          "index",
          "key",
          "title",
          "opening_statement"
        ],
        "title": "StageView",
        "description": "只描述學生**已經進入**的那一階。未進入的階不會出現在任何回應裡。"
      },
      "SummaryView": {
        "properties": {
          "core_principle": {
            "type": "string",
            "title": "Core Principle"
          },
          "stage_outcomes": {
            "items": {
              "$ref": "#/components/schemas/StageOutcomeView"
            },
            "type": "array",
            "title": "Stage Outcomes"
          }
        },
        "type": "object",
        "required": [
          "core_principle",
          "stage_outcomes"
        ],
        "title": "SummaryView"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
