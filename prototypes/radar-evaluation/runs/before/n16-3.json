        "scores": [
          {
            "dimension_index": 0,
            "score": 4.0,
            "sources": [
              {
                "message_id": "83f5e286-43fe-4b10-8f86-3ad7766979f4",
                "quote": "不管救幾個人，殺一個無辜的人就是錯的，這條線不能跨。",
                "start": 0,
                "end": 26
              },
              {
                "message_id": "aea02d06-0626-49e6-b5e3-3b0c0632497b",
                "quote": "這是直接殺人。",
