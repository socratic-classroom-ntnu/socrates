          {
            "dimension_index": 1,
            "score": 1.0,
            "sources": [
              {
                "message_id": "e54c823d-e1e3-4531-b0c2-4a2e08e62ac6",
                "quote": "因為都是我在決定誰死",
                "start": 17,
                "end": 27
