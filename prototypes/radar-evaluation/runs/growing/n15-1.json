  "view": {
    "dimensions": [
      {
        "index": 0,
        "name": "判斷依據",
        "low_pole": "主要看行動的結果，認為能減少最多傷亡就是較好的選擇。",
        "high_pole": "主要看行動本身是否正當，認為不應主動傷害無辜的人，即使結果較好。",
        "source": "llm"
      },
      {
        "index": 1,
        "name": "責任歸屬",
        "low_pole": "認為拉動開關的人要為造成的傷亡負責，因為是他主動選擇介入。",
        "high_pole": "認為責任在於造成危險的情境本身，介入者只是在既有危險中做出選擇。",
        "source": "llm"
      },
      {
        "index": 2,
        "name": "人數的份量",
        "low_pole": "認為生命數量本身具有決定性，救越多人越應優先考慮。",
        "high_pole": "認為每個人的生命地位相同，不應因人數多寡而改變對個人的對待方式。",
        "source": "llm"
      },
      {
        "index": 3,
        "name": "情感與直覺",
        "low_pole": "信任直覺的反應，認為直覺感受能反映道德上真實的界線。",
        "high_pole": "傾向用推理檢驗直覺，認為情緒反應可能受情境細節或偏誤影響而需要修正。",
        "source": "llm"
      },
      {
        "index": 4,
        "name": "規則的彈性",
        "low_pole": "認為在特殊情境下可以打破一般原則，以實際後果為準。",
        "high_pole": "認為應該堅守一致的道德規則，避免因情境而隨意例外。",
        "source": "llm"
      }
    ],
